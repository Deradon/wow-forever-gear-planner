#!/bin/sh
# Privacy gate before a push (docs/release-maintenance.md §10.5): the pushed range of each ref, or the whole
# history (blobs, messages, tags, ref names) when the remote ref is new: the first push, a new tag or branch.
is_zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }
status=0 history_done=0
while read -r local_ref local_sha remote_ref remote_sha; do
  is_zero "$local_sha" && continue   # a deletion pushes no content
  if is_zero "$remote_sha"; then
    [ "$history_done" -eq 1 ] && continue
    node tools/privacy-check.js --history || status=1
    history_done=1
  else
    node tools/privacy-check.js --range "$remote_sha..$local_sha" || status=1
  fi
done
exit $status
